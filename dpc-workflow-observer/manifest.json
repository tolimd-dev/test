{
  "manifest_version": 3,
  "name": "DPC Workflow Observer",
  "version": "1.0.0",
  "description": "Tracks your clinical workflow to help identify and build automations for your DPC practice.",
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "scripting",
    "windows"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DPC Workflow Observer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
