generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String
  name         String
  role         String        @default("PATRON")
  bio          String?
  createdAt    DateTime      @default(now())
  events       Event[]
  reservations Reservation[]
}

model Event {
  id             String         @id @default(cuid())
  title          String
  description    String
  menu           String
  basePrice      Float
  pricePerPerson Float
  maxGuests      Int
  durationMins   Int            @default(180)
  hostId         String
  host           User           @relation(fields: [hostId], references: [id])
  availability   Availability[]
  sessions       EventSession[]
  createdAt      DateTime       @default(now())
}

model Availability {
  id        String @id @default(cuid())
  eventId   String
  event     Event  @relation(fields: [eventId], references: [id])
  dayOfWeek Int
  startTime String
}

model EventSession {
  id           String        @id @default(cuid())
  eventId      String
  event        Event         @relation(fields: [eventId], references: [id])
  date         DateTime
  reservations Reservation[]
  createdAt    DateTime      @default(now())

  @@unique([eventId, date])
}

model Reservation {
  id        String       @id @default(cuid())
  sessionId String
  session   EventSession @relation(fields: [sessionId], references: [id])
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  guests    Int          @default(1)
  createdAt DateTime     @default(now())

  @@unique([sessionId, userId])
}
